---
const { user } = Astro.locals;
---

<header class="border-b border-gray-200 bg-white">
  <nav
    class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-2 px-4 py-2 text-sm sm:px-6"
    aria-label="Nawigacja główna"
  >
    <a href="/" class="font-semibold text-gray-900 hover:text-blue-700">Sejmulator</a>
    {
      user ? (
        <div class="flex flex-wrap items-center gap-3">
          <span class="max-w-[200px] truncate text-gray-500 sm:max-w-none" title={user.email}>
            {user.email}
          </span>
          <a href="/simulations" class="text-blue-600 hover:underline">
            Moje symulacje
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-gray-600 hover:text-red-600 hover:underline">
              Wyloguj
            </button>
          </form>
        </div>
      ) : (
        <div class="flex items-center gap-3">
          <a href="/auth/signin" class="text-blue-600 hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-gray-600 hover:underline">
            Załóż konto
          </a>
        </div>
      )
    }
  </nav>
</header>
